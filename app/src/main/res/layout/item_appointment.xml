<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ms_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/ms_icon_badge"
            android:layout_height="@dimen/ms_icon_badge"
            android:background="@drawable/ms_badge_mint"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_calendar"
            android:tint="@color/ms_primary" />

        <TextView
            android:id="@+id/tvAppointmentDetails"
            style="@style/MS.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.25" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditAppointment"
            style="@style/MS.Button.Small"
            android:layout_marginEnd="6dp"
            android:text="Edit" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteAppointment"
            style="@style/MS.Button.Small.Danger"
            android:layout_marginStart="6dp"
            android:text="Delete" />
    </LinearLayout>
</LinearLayout>
