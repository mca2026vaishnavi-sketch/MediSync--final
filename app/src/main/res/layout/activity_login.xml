<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ms_screen_pad_h"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/ms_screen_pad_h"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="MediSync logo"
            android:src="@drawable/ic_logo" />

        <TextView
            style="@style/MS.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Welcome Back" />

        <TextView
            style="@style/MS.Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="Login to continue your health journey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ms_card"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/etLoginUsername"
                style="@style/MS.Input"
                android:hint="Username"
                android:inputType="text"
                android:drawableStart="@drawable/ic_person"
                android:maxLines="1" />
            <EditText
                android:id="@+id/etLoginPassword"
                style="@style/MS.Input"
                android:hint="Password"
                android:inputType="textPassword"
                android:drawableStart="@drawable/ic_lock"
                android:layout_marginBottom="22dp"
                android:maxLines="1" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/MS.Button.Primary"
                android:text="Login" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGoToRegister"
            style="@style/MS.Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="Don't have an account? Register" />

    </LinearLayout>
</ScrollView>
