<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_pad_h"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/ms_screen_pad_h"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/MS.Text.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Good morning" />
                    <TextView
                        android:id="@+id/tvHomeName"
                        style="@style/MS.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Welcome" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/profileButton"
                    android:layout_width="@dimen/ms_touch_min"
                    android:layout_height="@dimen/ms_touch_min"
                    android:background="@drawable/ms_avatar"
                    android:clickable="true"
                    android:contentDescription="Open profile"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/ms_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ms_input_height"
                android:layout_marginTop="16dp"
                android:background="@drawable/ms_input_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/ms_hint" />
                <EditText
                    android:id="@+id/homeSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search medicines, appointments, records..."
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:textColor="@color/ms_text"
                    android:textColorHint="@color/ms_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardJourney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/ms_card_banner"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/MS.Text.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your Health Journey" />
                    <TextView style="@style/MS.Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Keep your health records in one place." />
                </LinearLayout>
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trend"
                    android:tint="@color/ms_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ms_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="start"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ms_badge_lavender"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_records"
                        android:tint="@color/ms_primary" />

                    <TextView
                        style="@style/MS.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Medical Records"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/MS.Text.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reports &amp; notes"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnReminders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ms_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="start"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ms_badge_mint"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/ms_primary" />

                    <TextView
                        style="@style/MS.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Reminders"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/MS.Text.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Medicine &amp; visits"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/MS.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Schedule" />
                <TextView
                    android:id="@+id/btnCalendar"
                    style="@style/MS.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="View Calendar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/tileDay1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/ms_date_tile_selected"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvDayName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDayNum1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/tileDay2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/ms_date_tile"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvDayName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ms_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDayNum2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ms_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/tileDay3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/ms_date_tile"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvDayName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ms_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDayNum3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ms_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/tileDay4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/ms_date_tile"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvDayName4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ms_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDayNum4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ms_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/MS.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Health Tools" />
                <TextView
                    android:id="@+id/btnRemindersHeader"
                    style="@style/MS.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="See all" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ms_card"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowMedicines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/ms_icon_badge"
                        android:layout_height="@dimen/ms_icon_badge"
                        android:background="@drawable/ms_badge_pink"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_pill"
                        android:tint="@color/ms_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/MS.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Medicines" android:textStyle="bold" />
                        <TextView style="@style/MS.Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dosage and schedule" android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/ms_hint" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="@color/ms_divider" />
                <LinearLayout
                    android:id="@+id/rowAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/ms_icon_badge"
                        android:layout_height="@dimen/ms_icon_badge"
                        android:background="@drawable/ms_badge_blue"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/ms_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/MS.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Appointments" android:textStyle="bold" />
                        <TextView style="@style/MS.Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Doctor visits" android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/ms_hint" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="3">
                <TextView
                    android:id="@+id/btnResolve"
                    style="@style/MS.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ms_card"
                    android:clickable="true"
                    android:drawableTop="@drawable/ic_sparkle"
                    android:drawableTint="@color/ms_primary"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="92dp"
                    android:padding="10dp"
                    android:text="Health Guidance"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cardMediBot"
                    style="@style/MS.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ms_card"
                    android:clickable="true"
                    android:drawableTop="@drawable/ic_chat"
                    android:drawableTint="@color/ms_primary"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="92dp"
                    android:padding="10dp"
                    android:text="MediBot"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btnEmergency"
                    style="@style/MS.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ms_card"
                    android:clickable="true"
                    android:drawableTop="@drawable/ic_emergency"
                    android:drawableTint="@color/ms_primary"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="92dp"
                    android:padding="10dp"
                    android:text="Emergency Contact"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ms_nav_height"
        android:background="@drawable/ms_nav_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4">
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                android:tint="@color/ms_nav_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="@color/ms_nav_tint"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navRecords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_records"
                android:tint="@color/ms_nav_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Records"
                android:textColor="@color/ms_nav_tint"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navReminders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell"
                android:tint="@color/ms_nav_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Reminders"
                android:textColor="@color/ms_nav_tint"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                android:tint="@color/ms_nav_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="@color/ms_nav_tint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
