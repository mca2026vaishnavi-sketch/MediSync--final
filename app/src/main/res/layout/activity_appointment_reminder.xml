<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ms_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/MS.Back" />
        <TextView
            style="@style/MS.Text.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/ms_touch_min"
            android:text="Book Appointment" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_pad_h"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ms_screen_pad_h"
            android:paddingBottom="24dp">

            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor" />
            <EditText
                android:id="@+id/etDoctorName"
                style="@style/MS.Input"
                android:hint="Doctor's name"
                android:inputType="textCapWords"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital / Clinic" />
            <EditText
                android:id="@+id/etHospitalName"
                style="@style/MS.Input"
                android:hint="Hospital or clinic name"
                android:inputType="textCapSentences"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date" />
            <EditText
                android:id="@+id/etAppointmentDate"
                style="@style/MS.Input"
                android:hint="Select date"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_calendar" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time" />
            <EditText
                android:id="@+id/etAppointmentTime"
                style="@style/MS.Input"
                android:hint="Select time (e.g. 20:45)"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_clock" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for visit" />
            <EditText
                android:id="@+id/etAppointmentDescription"
                style="@style/MS.Input.Multiline"
                android:hint="E.g. Follow-up visit"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ms_screen_pad_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ms_screen_pad_h"
        android:paddingBottom="16dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveAppointment"
            style="@style/MS.Button.Primary"
            android:text="Save Appointment" />

    </LinearLayout>
</LinearLayout>
