<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ms_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/MS.Back" />
        <TextView
            style="@style/MS.Text.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/ms_touch_min"
            android:text="MediBot" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ms_screen_pad_h"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/ms_screen_pad_h"
        android:paddingBottom="8dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHealthyHabits"
                style="@style/MS.Chip"
                android:text="Healthy habits" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMedicineHelp"
                style="@style/MS.Chip"
                android:text="Missed a medicine?" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAppointmentHelp"
                style="@style/MS.Chip"
                android:text="Doctor appointments" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAppHelp"
                style="@style/MS.Chip"
                android:text="How to use MediSync" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_pad_h"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ms_screen_pad_h"
            android:paddingBottom="8dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ms_screen_pad_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ms_screen_pad_h"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/etMessage"
            style="@style/MS.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:background="@drawable/ms_input_bg"
            android:hint="Ask MediBot..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoice"
            android:layout_width="@dimen/ms_input_height"
            android:layout_height="@dimen/ms_input_height"
            android:layout_marginStart="8dp"
            android:background="@drawable/ms_btn_mic"
            android:contentDescription="Speak your question"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/ms_input_height"
            android:layout_height="@dimen/ms_input_height"
            android:layout_marginStart="8dp"
            android:background="@drawable/ms_btn_send"
            android:contentDescription="Send message"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</LinearLayout>
