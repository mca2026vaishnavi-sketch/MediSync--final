<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ms_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/MS.Back" />
        <TextView
            style="@style/MS.Text.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/ms_touch_min"
            android:text="Medical Records" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_pad_h"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ms_screen_pad_h"
            android:paddingBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHealthProfile"
                style="@style/MS.Button.Row"
                android:drawableStart="@drawable/ic_heart"
                android:drawableEnd="@drawable/ic_chevron"
                android:text="Health Profile" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMedicine"
                style="@style/MS.Button.Row"
                android:drawableStart="@drawable/ic_pill"
                android:drawableEnd="@drawable/ic_chevron"
                android:text="Medicine Details" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMedicalReport"
                style="@style/MS.Button.Row"
                android:drawableStart="@drawable/ic_records"
                android:drawableEnd="@drawable/ic_chevron"
                android:text="Medical Report" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEmergencyContact"
                style="@style/MS.Button.Row"
                android:drawableStart="@drawable/ic_emergency"
                android:drawableEnd="@drawable/ic_chevron"
                android:text="Emergency Contact" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAppointmentReminder"
                style="@style/MS.Button.Row"
                android:drawableStart="@drawable/ic_calendar"
                android:drawableEnd="@drawable/ic_chevron"
                android:text="Appointment Reminders" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
