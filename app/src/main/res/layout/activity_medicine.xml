<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ms_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/MS.Back" />
        <TextView
            style="@style/MS.Text.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/ms_touch_min"
            android:text="Add Medicine" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_pad_h"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ms_screen_pad_h"
            android:paddingBottom="24dp">

            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name" />
            <EditText
                android:id="@+id/etMedicineName"
                style="@style/MS.Input"
                android:hint="Medicine name"
                android:inputType="textCapSentences"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosage" />
            <EditText
                android:id="@+id/etDosage"
                style="@style/MS.Input"
                android:hint="Dosage (e.g. 500 mg)"
                android:inputType="text"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequency" />
            <EditText
                android:id="@+id/etFrequency"
                style="@style/MS.Input"
                android:hint="Frequency (e.g. twice daily)"
                android:inputType="textCapSentences"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time" />
            <EditText
                android:id="@+id/etTime"
                style="@style/MS.Input"
                android:hint="Time (e.g. 8:00 AM)"
                android:inputType="text"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Date" />
            <EditText
                android:id="@+id/etStartDate"
                style="@style/MS.Input"
                android:hint="Start date (e.g. 10/10/2026)"
                android:inputType="text"
                android:maxLines="1" />
            <TextView
                style="@style/MS.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Date" />
            <EditText
                android:id="@+id/etEndDate"
                style="@style/MS.Input"
                android:hint="End date (e.g. 20/10/2026)"
                android:inputType="text"
                android:maxLines="1" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ms_screen_pad_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ms_screen_pad_h"
        android:paddingBottom="16dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveMedicine"
            style="@style/MS.Button.Primary"
            android:text="Save Medicine" />

    </LinearLayout>
</LinearLayout>
