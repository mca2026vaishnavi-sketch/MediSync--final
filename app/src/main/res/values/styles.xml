<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MS.Text.Title" parent="">
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MS.Text.Header" parent="">
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MS.Text.Section" parent="">
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MS.Text.Body" parent="">
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="MS.Text.Muted" parent="">
        <item name="android:textColor">@color/ms_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="MS.Text.Label" parent="">
        <item name="android:textColor">@color/ms_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>
    <style name="MS.Text.Link" parent="">
        <item name="android:textColor">@color/ms_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">@dimen/ms_touch_min</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MS.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ms_input_height</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/ms_input_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textColorHint">@color/ms_hint</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/ms_hint</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="MS.Input.Multiline" parent="MS.Input">
        <item name="android:minHeight">120dp</item>
        <item name="android:gravity">top|start</item>
    </style>

    <style name="MS.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ms_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="MS.Button.Primary">
        <item name="android:background">@drawable/ms_btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="MS.Button.Secondary">
        <item name="android:background">@drawable/ms_btn_secondary</item>
        <item name="android:textColor">@color/ms_primary</item>
    </style>
    <style name="MS.Button.Row">
        <item name="android:background">@drawable/ms_card</item>
        <item name="android:textColor">@color/ms_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:drawableTint">@color/ms_primary</item>
    </style>
    <style name="MS.Button.Small" parent="MS.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/ms_btn_secondary</item>
        <item name="android:textColor">@color/ms_primary</item>
    </style>
    <style name="MS.Button.Small.Danger">
        <item name="android:textColor">@color/ms_danger</item>
    </style>
    <style name="MS.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/ms_chip</item>
        <item name="android:textColor">@color/ms_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MS.Back" parent="">
        <item name="android:layout_width">@dimen/ms_touch_min</item>
        <item name="android:layout_height">@dimen/ms_touch_min</item>
        <item name="android:background">@drawable/ms_circle_ripple</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:tint">@color/ms_text</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">Back</item>
    </style>
</resources>
